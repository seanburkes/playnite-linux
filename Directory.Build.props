<Project>
  <!-- Keep the frozen Windows oracle and standalone Phase 1 tools/spikes independent. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src$([System.IO.Path]::DirectorySeparatorChar)')) Or $(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)tests$([System.IO.Path]::DirectorySeparatorChar)'))">
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>
  <!-- API bans apply to product code, never test runners or the frozen oracle. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src$([System.IO.Path]::DirectorySeparatorChar)'))">
    <PlayniteProductProject>true</PlayniteProductProject>
    <!-- Explicit GC.Collect harness allowlist. Empty until a benchmark/soak project is
         reviewed; a product cannot self-declare because this file is imported before the
         project body and the attachment condition below has already evaluated. -->
    <PlayniteBenchmarkHarnessProjects Condition="'$(PlayniteBenchmarkHarnessProjects)' == ''"></PlayniteBenchmarkHarnessProjects>
  </PropertyGroup>
  <ItemGroup Condition="'$(PlayniteProductProject)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Library.txt" Condition="'$(MSBuildProjectName)' != 'Playnite.Cli' And '$(MSBuildProjectName)' != 'Playnite.Desktop' And '$(MSBuildProjectName)' != 'Playnite.LegacyImport'" />
    <!-- PORTING allows .Result/.Wait() only at a commented top-level Cli entry point, so the
         symbol file stops short of Cli and SourcePolicy checks the contextual exception. -->
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Blocking.txt" Condition="'$(MSBuildProjectName)' != 'Playnite.Cli'" />
    <!-- PORTING allows GC.Collect only in a benchmark/soak harness with a comment. The harness
         names are an explicit policy allowlist in the property above; SourcePolicy holds the
         same reviewed list and requires a comment, so the allowlist alone permits nothing. -->
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.GcCollect.txt" Condition="!$([System.String]::Copy(';$(PlayniteBenchmarkHarnessProjects);').Contains(';$(MSBuildProjectName);'))" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Core.txt" Condition="'$(MSBuildProjectName)' == 'Playnite.Core'" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Logic.txt" Condition="'$(MSBuildProjectName)' == 'Playnite.Core' Or '$(MSBuildProjectName)' == 'Playnite.SDK.Abstractions' Or '$(MSBuildProjectName)' == 'Playnite.Steam'" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Interop.txt" Condition="'$(MSBuildProjectName)' != 'Playnite.Platform.Linux'" />
  </ItemGroup>
</Project>
