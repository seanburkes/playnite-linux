<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Playnite.Desktop.Setup.FirstTimeStartupWindow"
        Title="Set up Playnite"
        Width="680"
        Height="560"
        MinWidth="380"
        MinHeight="340"
        WindowStartupLocation="CenterScreen">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="26" Spacing="14">
      <StackPanel Spacing="4">
        <TextBlock Text="PLAYNITE LINUX" Classes="section-label" />
        <TextBlock Text="Choose a library source" Classes="h1" FontSize="22" />
      </StackPanel>

      <StackPanel x:Name="Choices" Spacing="14">
        <Border x:Name="ImportSource"
                Background="{DynamicResource PlayniteSurfaceBrush}"
                BorderBrush="{DynamicResource PlayniteBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="18">
          <StackPanel Spacing="10">
            <TextBlock Text="Import Playnite 10 Library" Classes="h2" />
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource PlayniteTextSecondaryBrush}"
                       LineHeight="19"
                       Text="Choose your Playnite 10 folder (or its library subfolder) on a mounted Windows partition, USB drive, or network share. Close Playnite 10 before copying. Import is one-way and does not change the source. Steam games are brought over; unsupported records are kept in the migration backup." />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox x:Name="SourcePath" PlaceholderText="Mounted Playnite folder"
                       AutomationProperties.Name="Mounted Playnite folder" />
              <Button x:Name="BrowseButton" Grid.Column="1" Classes="secondary-cta" Content="Browse…" Click="OnBrowse" />
            </Grid>
            <TextBox x:Name="WindowsPath" PlaceholderText="Original Windows path of this folder (optional)"
                     AutomationProperties.Name="Original Windows path of this folder (optional)" />
            <TextBlock TextWrapping="Wrap"
                       Classes="muted"
                       Text="Select the parent Playnite folder to include config.json. Provide its original Windows path only if you know it; otherwise Windows settings paths are retained and reported as unmapped." />
            <Button x:Name="ImportButton" Classes="primary-cta" Content="Import Playnite 10 library" HorizontalAlignment="Left" Click="OnImport" />
          </StackPanel>
        </Border>

        <Border Background="{DynamicResource PlayniteSurfaceBrush}"
                BorderBrush="{DynamicResource PlayniteBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="18">
          <StackPanel Spacing="10">
            <TextBlock Text="Fresh Steam Setup" Classes="h2" />
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource PlayniteTextSecondaryBrush}"
                       LineHeight="19"
                       Text="Starting without a Windows library? Set up with games Steam already knows about on this machine." />
            <StackPanel HorizontalAlignment="Left" Spacing="10">
              <Button x:Name="SteamButton" Classes="secondary-cta" Content="Set up with Steam" Click="OnSteam" />
              <Button x:Name="KeepButton" Classes="secondary-cta" Content="Keep my existing Linux library" Click="OnKeep" IsVisible="False" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <ProgressBar x:Name="ProgressBar" IsIndeterminate="True" IsVisible="False"
                   AutomationProperties.Name="Setup progress" />
      <TextBlock x:Name="StatusText"
                 TextWrapping="Wrap"
                 FontWeight="Medium"
                 AutomationProperties.LiveSetting="Polite" />
      <SelectableTextBlock x:Name="DetailsText"
                           Foreground="{DynamicResource PlayniteTextSecondaryBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="CancelButton" Classes="secondary-cta" Content="Cancel" IsVisible="False" Click="OnCancel" />
        <Button x:Name="FinishButton" Classes="primary-cta" Content="Finish" IsVisible="False" Click="OnFinish" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
