<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Playnite.Desktop.Shell.AboutView">
  <StackPanel>
    <TextBlock x:Name="AboutTitleText" AutomationProperties.Name="About title" />
    <TextBlock x:Name="AboutMessageText" AutomationProperties.Name="About author" />
  </StackPanel>
</UserControl>
