<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Playnite.Desktop.Shell.PluginManagerWindow"
        Width="780"
        Height="540"
        MinWidth="640"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Title="Plugins &amp; Add-ons">
  <Border Background="{DynamicResource PlayniteSurfaceBrush}"
          BorderBrush="{DynamicResource PlayniteBorderBrush}"
          BorderThickness="1"
          Padding="18">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
      <StackPanel Grid.Row="0" Spacing="4">
        <TextBlock Text="Plugins &amp; Add-ons" Classes="h2"
                   AutomationProperties.Name="Plugins manager title" />
        <TextBlock x:Name="SummaryText" Classes="muted" TextWrapping="Wrap"
                   AutomationProperties.Name="Plugin host summary" />
      </StackPanel>

      <Grid Grid.Row="1" ColumnDefinitions="255,*" ColumnSpacing="14">
        <Border Grid.Column="0"
                Background="{DynamicResource PlayniteCardBackgroundBrush}"
                BorderBrush="{DynamicResource PlayniteBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="6">
          <ListBox x:Name="PluginList"
                   SelectionMode="Single"
                   Background="Transparent"
                   BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   AutomationProperties.Name="Installed plugins" />
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12" Margin="0,0,6,0">
            <StackPanel Spacing="4">
              <TextBlock x:Name="SelectedPluginName" Classes="h2" Text="Select a plugin"
                         TextWrapping="Wrap"
                         AutomationProperties.Name="Selected plugin name" />
              <TextBlock x:Name="SelectedPluginMeta" Classes="muted" FontSize="12"
                         TextWrapping="Wrap"
                         AutomationProperties.Name="Selected plugin details" />
              <TextBlock x:Name="SelectedPluginDescription" Classes="muted"
                         TextWrapping="Wrap" IsVisible="False" />
            </StackPanel>

            <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="6">
              <CheckBox x:Name="EnabledToggle" Content="Enabled"
                        AutomationProperties.Name="Plugin enabled" />
              <Button x:Name="LoadSettingsButton" Classes="secondary-cta"
                      Content="Load Settings" IsVisible="False"
                      AutomationProperties.Name="Activate plugin to load settings" />
            </WrapPanel>

            <Border x:Name="SelectedDiagnosticsPanel" IsVisible="False"
                    Background="{DynamicResource PlayniteCardBackgroundBrush}"
                    BorderBrush="{DynamicResource PlayniteDangerBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="10">
              <StackPanel Spacing="4">
                <TextBlock Text="Plugin Diagnostics" FontWeight="SemiBold"
                           Foreground="{DynamicResource PlayniteDangerBrush}" />
                <StackPanel x:Name="SelectedDiagnosticsList" Spacing="4" />
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource PlayniteCardBackgroundBrush}"
                    BorderBrush="{DynamicResource PlayniteBorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12">
              <StackPanel Spacing="10">
                <TextBlock x:Name="SettingsHeading" Text="Settings" FontWeight="SemiBold" />
                <TextBlock x:Name="NoSettingsHint" Classes="muted" TextWrapping="Wrap" IsVisible="False" />
                <StackPanel x:Name="SettingsFieldsPanel" Spacing="10" IsVisible="False" />
                <WrapPanel x:Name="SettingsActionsPanel" Orientation="Horizontal" ItemSpacing="8"
                           LineSpacing="6" IsVisible="False">
                  <Button x:Name="SaveSettingsButton" Classes="primary-cta" Content="Save Settings"
                          IsDefault="True"
                          AutomationProperties.Name="Save plugin settings" />
                  <Button x:Name="ResetDefaultsButton" Classes="secondary-cta" Content="Reset Defaults"
                          AutomationProperties.Name="Reset plugin defaults" />
                </WrapPanel>
                <TextBlock x:Name="SettingsStatusText" IsVisible="False" TextWrapping="Wrap"
                           AutomationProperties.Name="Plugin settings status"
                           AutomationProperties.LiveSetting="Assertive" />
              </StackPanel>
            </Border>

            <Border x:Name="HostDiagnosticsPanel" IsVisible="False"
                    Background="{DynamicResource PlayniteCardBackgroundBrush}"
                    BorderBrush="{DynamicResource PlayniteBorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="10">
              <StackPanel Spacing="4">
                <TextBlock Text="Host &amp; Discovery Diagnostics" FontWeight="SemiBold"
                           Foreground="{DynamicResource PlayniteMixedBrush}" />
                <StackPanel x:Name="HostDiagnosticsList" Spacing="4" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="CloseButton" Classes="secondary-cta" Content="Close" IsCancel="True"
                AutomationProperties.Name="Close plugins manager" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
