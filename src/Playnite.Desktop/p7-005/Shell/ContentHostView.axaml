<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Playnite.Desktop.Shell"
             x:Class="Playnite.Desktop.Shell.ContentHostView">
  <Grid ColumnDefinitions="*,Auto">
    <shell:LibraryGridView x:Name="LibraryGrid" Grid.Column="0" />
    <shell:GameEditView x:Name="GameEdit" Grid.Column="1" />
  </Grid>
</UserControl>
