<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="UiShellSpike.App" RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Themes/Default/Colors.axaml" />
        <ResourceInclude Source="/Themes/Default/Brushes.axaml" />
        <ResourceInclude Source="/Themes/Default/Spacing.axaml" />
        <ResourceInclude Source="/Themes/Default/Typography.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="/Themes/Default/Controls.axaml" />
    <StyleInclude Source="/Themes/Default/Templates.axaml" />
  </Application.Styles>
</Application>
