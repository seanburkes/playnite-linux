<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:UiShellSpike">
  <Styles.Resources>
    <DataTemplate x:Key="GameCard" x:DataType="local:Game">
      <Border Classes="surface" Width="{DynamicResource CardWidth}">
        <StackPanel Spacing="{DynamicResource RowGap}">
          <local:CoverArt Motif="{Binding Motif}" />
          <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
          <TextBlock Classes="playtime muted" Text="{Binding Playtime}" />
          <TextBlock Classes="lastplayed muted" Text="{Binding LastPlayed}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Styles.Resources>
</Styles>
