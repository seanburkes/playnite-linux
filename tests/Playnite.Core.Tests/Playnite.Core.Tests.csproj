<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.core.mtp-v2" />
    <PackageReference Include="xunit.v3.assert" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Playnite.Core/Playnite.Core.csproj" />
    <ProjectReference Include="../../src/Playnite.Cli/Playnite.Cli.csproj" />
    <ProjectReference Include="../../src/Playnite.LegacyImport/Playnite.LegacyImport.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Playnite.Platform.Linux/Playnite.Platform.Linux.csproj" />
    <ProjectReference Include="../../tools/Playnite.Fuzz/Playnite.Fuzz.csproj" />
    <ProjectReference Include="../../tools/SettingsMigration.CrashHost/SettingsMigration.CrashHost.csproj" />
    <ProjectReference Include="../../tools/AssetCopy.CrashHost/AssetCopy.CrashHost.csproj" />
    <ProjectReference Include="../../tools/Playnite.SingleInstance.Host/Playnite.SingleInstance.Host.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../golden/settings/*.json" Link="golden/settings/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../golden/paths/*.json" Link="golden/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../golden/loc/*.json" Link="golden/loc/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../golden/utils-v10.json" Link="utils-v10.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../golden/checksums-v10.json" Link="checksums-v10.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/manifests-v10/*" Link="manifests-v10/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/archives-v10/*" Link="archives-v10/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/archives-v10/source/**" Link="archives-v10/source/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../golden/archives/*" Link="golden-archives/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
